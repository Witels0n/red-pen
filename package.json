{
  "name": "red-pen",
  "version": "1.0.0",
  "description": "Free, private tools for teachers: marking, PDFs, QR codes and class lists. Everything runs in the browser; files are never uploaded.",
  "private": true,
  "license": "MIT",
  "homepage": "https://witels0n.github.io/red-pen/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Witels0n/red-pen.git"
  },
  "bugs": {
    "url": "https://github.com/Witels0n/red-pen/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:smoke": "tsc --noEmit && vite build --mode smoke",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "playwright test",
    "check": "npm run typecheck && npm run format:check && npm test"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/gochi-hand": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "qrcode-generator": "^2.0.4",
    "read-excel-file": "9.3.14"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "fake-indexeddb": "6.2.7",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1",
    "write-excel-file": "4.1.1"
  }
}
